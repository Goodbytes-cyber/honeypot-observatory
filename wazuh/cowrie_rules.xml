<!--
  Wazuh rules for the Cowrie honeypot (JSON log, cowrie.json).
  GoodBytes, https://goodbytes.fr - MIT licence (see LICENSE).

  No custom decoder is needed: Wazuh's built-in JSON decoder extracts the
  Cowrie fields (eventid, src_ip, username, password, input...).
  IDs 100230-100234 are in the local range; renumber them if they collide
  with your own rules.
-->
<group name="cowrie,honeypot,">
  <rule id="100230" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>Cowrie honeypot events.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100231" level="5">
    <if_sid>100230</if_sid>
    <field name="eventid">cowrie.session.connect</field>
    <description>Honeypot: new connection from $(src_ip)</description>
    <group>honeypot_connect,</group>
  </rule>

  <rule id="100232" level="5">
    <if_sid>100230</if_sid>
    <field name="eventid">cowrie.login.failed</field>
    <description>Honeypot: failed login from $(src_ip) ($(username)/$(password))</description>
    <group>honeypot_login_failed,</group>
  </rule>

  <!-- The decoy accepts almost any password: an accepted login is not a real
       compromise, it only means the attacker is now in the fake shell. -->
  <rule id="100233" level="8">
    <if_sid>100230</if_sid>
    <field name="eventid">cowrie.login.success</field>
    <description>Honeypot: login accepted by the decoy from $(src_ip) ($(username)/$(password))</description>
    <group>honeypot_login_success,</group>
  </rule>

  <rule id="100234" level="8">
    <if_sid>100230</if_sid>
    <field name="eventid">cowrie.command.input</field>
    <description>Honeypot: command typed by the attacker from $(src_ip): $(input)</description>
    <group>honeypot_command,</group>
  </rule>
</group>
